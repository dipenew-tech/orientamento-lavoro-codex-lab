{
  "name": "caritas-firebase-local-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:browser": "playwright install chromium",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "emulators": "node scripts/local.mjs emulators",
    "dev": "node scripts/local.mjs dev",
    "seed": "node scripts/local.mjs seed",
    "export": "node scripts/local.mjs export",
    "import": "node scripts/local.mjs import",
    "test": "npm run build && node scripts/local.mjs test",
    "test:guards": "node --import tsx --test tests/guards.test.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "firebase": "12.4.0",
    "firebase-admin": "13.6.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "4.17.21",
    "@types/node": "22.14.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "esbuild": "0.25.0",
    "firebase-tools": "14.26.0",
    "tsx": "4.21.0",
    "typescript": "5.8.2"
  }
}
